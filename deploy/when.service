[Unit]
Description=When cron explainer (when.hermz.xyz)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/luke/tools/when
Environment=WHEN_HOST=127.0.0.1
Environment=WHEN_PORT=8881
Environment=WHEN_PUBLIC_HOST=https://when.hermz.xyz
ExecStart=/home/luke/tools/when/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8881 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
